# Copy this file to .env and fill in your real key.
#
# DeepSeek uses an OpenAI-compatible API. Keep the base URL unchanged unless
# DeepSeek documents a special endpoint for your chosen model.
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# OpenAI example:
# LLM_API_KEY=your_openai_api_key
# LLM_MODEL=o3-mini
# LLM_BASE_URL=
